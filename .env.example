DATABASE_URL="mysql://username:password@127.0.0.1:3306/school_id_card_management"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3000
NODE_ENV=production

# Number of reverse proxies between the public internet and Express.
# The default in production is 1, which is correct for a single Nginx proxy.
TRUST_PROXY=1

# Required when running `pnpm db:setup` or `pnpm db:seed-auth` (set a strong unique password, min 12 chars).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
