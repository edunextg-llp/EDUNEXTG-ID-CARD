DATABASE_URL="mysql://username:password@127.0.0.1:3306/school_id_card_management"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3000
NODE_ENV=production

# Reverse proxy trust settings.
# Crucial for accurate client IP resolution in rate limiting and audit logs.
# - If running behind a single reverse proxy (e.g. Nginx -> Node): set to 1 (default in production).
# - If running behind multi-tier proxies (e.g. Cloudflare -> Nginx/ALB -> Node): set to the number of hops (e.g. 2).
# - Can also be set to boolean ('true' / 'false') or specific subnet strings (e.g. 'loopback, linklocal, uniquelocal').
# Note: When deployed behind Cloudflare, the rate limiter automatically honors the 'cf-connecting-ip' header.
TRUST_PROXY=1

# Required when running `pnpm db:setup` or `pnpm db:seed-auth` (set a strong unique password, min 12 chars).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
